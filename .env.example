# Telegram
BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_USER_ID=replace_with_numeric_telegram_user_id

# System
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite:///./data/app.db

# Google Calendar
GOOGLE_CALENDAR_ID=replace_with_google_calendar_id
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json

# Telegram delivery mode: polling | webhook
TELEGRAM_DELIVERY_MODE=polling
TELEGRAM_DROP_PENDING_UPDATES_ON_START=false

# Webhook settings (used only when TELEGRAM_DELIVERY_MODE=webhook)
TELEGRAM_WEBHOOK_BASE_URL=https://bot.example.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret_token
TELEGRAM_WEBHOOK_LISTEN_HOST=0.0.0.0
TELEGRAM_WEBHOOK_LISTEN_PORT=8080
